      function orderMessage() {
        const lines = bag.map((i, k) => (k + 1) + '. ' + i.n + '\n   Qty: ' + i.q + ' x ' + fmt(i.p) + ' = ' + fmt(i.p * i.q) + notes(i).map(t => '\n   ' + t).join('') + (i.g || []).map(g => '\n   + Gift: ' + g.n + ' = ' + fmt(g.p * i.q)).join(''));
        return 'Hello dé keepsake smith, I would like to place this order:\n\n' + lines.join('\n\n') + '\n\nItems: ' + count() + '\nTotal: ' + fmt(total()) + ' (delivery fee to be confirmed)\n\nDelivery date (earliest ' + iso(earliest()) + '): ' + (del.d || '') + '\nRecipient name: ' + (del.r || '') + '\nDelivery area: ' + (del.a || '') + '\n\nName:\nDelivery address:';
      }
      function waOrder() {
        if (!bag.length) return;
        const msg = orderMessage();
        // start the copy and open WhatsApp in the same click so the browser allows both
        const done = copyText(msg);
        window.open(waURL(msg), '_blank', 'noopener');
        const m = document.getElementById('wamsg'); if (m) m.textContent = 'Opening WhatsApp…';
        done.then(ok => { const m2 = document.getElementById('wamsg'); if (m2) m2.textContent = ok ? 'Order copied and WhatsApp opened. If the message box is empty, paste it in and send.' : 'WhatsApp opened with your order.' });
      }
      function payNow(name, email, addr) {
        const go = () => {
          const h = PaystackPop.setup({ key: DKS.paystackKey, email: email, amount: total() * 100, currency: 'NGN', metadata: { custom_fields: [{ display_name: 'Name', variable_name: 'name', value: name }, { display_name: 'Address', variable_name: 'address', value: addr }, { display_name: 'Recipient', variable_name: 'recipient', value: del.r }, { display_name: 'Delivery area', variable_name: 'area', value: del.a }, { display_name: 'Delivery date', variable_name: 'date', value: del.d }, { display_name: 'Items', variable_name: 'items', value: itemsText() }] }, callback: function () { bag = []; view = 'done'; save(); renderBag() }, onClose: function () { } });
          h.openIframe();
        };
        if (window.PaystackPop) { go(); return }
        const s = document.createElement('script'); s.src = 'https://js.paystack.co/v1/inline.js'; s.onload = go; s.onerror = () => { const e = document.getElementById('cerr'); if (e) e.textContent = 'Could not reach the payment service. Please try again or order on WhatsApp.' }; document.head.appendChild(s);
      }
      bagEl.addEventListener('keydown', e => { if (e.key !== 'Tab') return; const f = [...bagEl.querySelectorAll('button,input,textarea,a[href]')].filter(x => !x.disabled && x.offsetParent !== null); if (!f.length) return; const a = f[0], z = f[f.length - 1]; if (e.shiftKey && document.activeElement === a) { z.focus(); e.preventDefault() } else if (!e.shiftKey && document.activeElement === z) { a.focus(); e.preventDefault() } });

      // contact popup (header Contact link; mailto stays as the no-JS fallback)
      const ctEl = $('#ct'), ctBody = $('#ctb'); let ctFocus = null;
      const ctOpen = () => ctEl.classList.contains('open');
      function ctRender() {
        const em = DKS.email, wa = DKS.whatsapp, ig = DKS.instagram;
        ctBody.innerHTML = '<h2>Say hello</h2><p class="cts">Questions, custom work or an order in progress. We reply within a day.</p>'
          + (em ? '<div class="ctr"><span>Email</span><span class="ctv"><a href="mailto:' + em + '">' + em + '</a><button type="button" class="lnk" data-ct="copy">Copy</button></span></div>' : '')
          + (wa ? '<a class="ctr" href="' + waURL('Hello, I would like to ask about a piece.') + '" target="_blank" rel="noopener"><span>WhatsApp</span><span>Message us</span></a>' : '')
          + (ig ? '<a class="ctr" href="' + ig + '" target="_blank" rel="noopener"><span>Instagram</span><span>Follow along</span></a>' : '')
          + '<button type="button" class="gbtn" data-ct="commission">Commission a piece</button>';
      }
      function openCT() { ctRender(); ctFocus = document.activeElement; ctEl.classList.add('open'); scrim.classList.add('open'); ctEl.setAttribute('aria-hidden', 'false'); setTimeout(() => { const a = ctEl.querySelector('.ctv a,.ctr,.gbtn'); if (a) a.focus() }, 60) }
      function closeCT() { if (!ctOpen()) return; ctEl.classList.remove('open'); if (!bagOpen() && !gfOpen()) scrim.classList.remove('open'); ctEl.setAttribute('aria-hidden', 'true'); if (ctFocus && ctFocus.focus) ctFocus.focus() }
      document.addEventListener('click', e => {
        const a = e.target.closest('[data-contact]');
        if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
        e.preventDefault(); openCT();
      });
      $('#ctx').addEventListener('click', closeCT); scrim.addEventListener('click', closeCT);
      ctEl.addEventListener('click', e => {
        const b = e.target.closest('[data-ct]'); if (!b) return;
        if (b.dataset.ct === 'commission') { closeCT(); goTo('studio', 's-commission'); return }
        if (b.dataset.ct === 'copy') {
          const t = b.querySelector('i') || b, was = 'Copy';
          const done = ok => { t.textContent = ok ? 'Copied' : 'Failed'; clearTimeout(b._t); b._t = setTimeout(() => { t.textContent = was }, 1600) };
          const fb = () => { try { const x = document.createElement('textarea'); x.value = DKS.email; x.setAttribute('readonly', ''); x.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0'; document.body.appendChild(x); x.select(); x.setSelectionRange(0, 99); const ok = document.execCommand('copy'); x.remove(); done(ok) } catch (_) { done(false) } };
          if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(DKS.email).then(() => done(true), fb); else fb();
        }
      });
      ctEl.addEventListener('keydown', e => { if (e.key !== 'Tab') return; const f = [...ctEl.querySelectorAll('button,a[href]')].filter(x => !x.disabled && x.offsetParent !== null); if (!f.length) return; const a = f[0], z = f[f.length - 1]; if (e.shiftKey && document.activeElement === a) { z.focus(); e.preventDefault() } else if (!e.shiftKey && document.activeElement === z) { a.focus(); e.preventDefault() } });

      // text roll on every clickable nav item and button (re-applied when the page re-renders them)
      const RSEL = '.mn a,.nm .po,.bag,.ttb,.padd,.btn,.gbtn,.chip,.lnk,.ft a,.ft button,.ftx a,.ftx button,#gfbtn,.bh button,.eg button';
      function rl(el) {
        if (el.querySelector(':scope>.rl')) return;
        const t = el.textContent.trim(); if (!t) return;
        const w = document.createElement('span'), i = document.createElement('i');
        w.className = 'rl'; i.dataset.t = t;
        while (el.firstChild) i.appendChild(el.firstChild);
        w.appendChild(i); el.appendChild(w);
      }
      document.querySelectorAll(RSEL).forEach(rl);
      new MutationObserver(ms => {
        ms.forEach(m => {
          const t = m.target.nodeType === 1 ? m.target : m.target.parentElement; if (!t) return;
          const i = t.closest('.rl i'); if (i) { i.dataset.t = i.textContent.trim(); return }
          const e = t.closest(RSEL); if (e) rl(e);
          if (t.querySelectorAll) t.querySelectorAll(RSEL).forEach(rl);
        })
      }).observe(document.body, { childList: true, subtree: true, characterData: true });

      // smooth scroll for the vertical pages (About, Studio): eased wheel, same feel as the strips
      if (!RM) {
        document.querySelectorAll('.page').forEach(pg => {
          const st = { t: 0, pos: 0, raf: 0, last: 0 };
          const max = () => Math.max(0, pg.scrollHeight - pg.clientHeight);
          const clamp = v => Math.max(0, Math.min(max(), v));
          const loop = now => {
            const dt = Math.min(64, now - (st.last || now)); st.last = now;
            const d = st.t - st.pos;
            if (Math.abs(d) < .4) { st.pos = st.t; pg.scrollTop = st.pos; st.raf = 0; st.last = 0; return }
            st.pos += d * (1 - Math.pow(1 - .12, dt / 16.67));
            pg.scrollTop = st.pos;
            st.raf = requestAnimationFrame(loop);
          };
          pg._sgo = y => { if (!st.raf) st.pos = pg.scrollTop; st.t = clamp(y); if (!st.raf) st.raf = requestAnimationFrame(loop) };
          pg.addEventListener('wheel', e => {
            if (e.defaultPrevented || e.ctrlKey || mode !== 'page' || !pg.closest('.card').classList.contains('on')) return;
            if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || !max()) return;
            if (e.target.closest && e.target.closest('textarea,select')) return;
            if (!st.raf) st.t = st.pos = pg.scrollTop;
            const k = e.deltaMode === 1 ? 40 : e.deltaMode === 2 ? pg.clientHeight : 1;
            st.t = clamp(st.t + e.deltaY * k);
            if (!st.raf) st.raf = requestAnimationFrame(loop);
            e.preventDefault();
          }, { passive: false });
          // anything else that moves the page (keyboard, scrollbar, reset to top) takes over from the ease
          pg.addEventListener('scroll', () => { if (Math.abs(pg.scrollTop - st.pos) > 2) { cancelAnimationFrame(st.raf); st.raf = 0; st.last = 0; st.pos = st.t = pg.scrollTop } }, { passive: true });
        });
      }

      // structured data for search engines
      try {
        const ld = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: P.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: p.n, description: DET[p.t], offers: { '@type': 'Offer', price: p.p, priceCurrency: 'NGN', availability: 'https://schema.org/InStock' } } })) };
        const s = document.createElement('script'); s.type = 'application/ld+json'; s.textContent = JSON.stringify(ld); document.head.appendChild(s);
      } catch (e) { }

      renderBag(); pdpRoute();

      route();
      requestAnimationFrame(() => requestAnimationFrame(() => document.body.classList.add('ready')));
    })();
  </script>
</body>


    }

    html,
    body {
      height: 100%;
      margin: 0;
      overflow: hidden;
      background: var(--olive);
      color: var(--ink);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-weight: 400;
      -webkit-font-smoothing: antialiased

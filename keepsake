    a {
      color: inherit;
      text-decoration: none
    }

    a:focus-visible,
    button:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px
    }

    #world {
      position: absolute;
      left: 0;
      top: 0;
      display: flex;
      gap: var(--gap);
      transform-origin: 0 0
    }

    .ready #world {
      transition: transform var(--t) var(--ease)

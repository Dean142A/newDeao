    [data-mode=menu] .card {
      cursor: pointer
    }

    [data-mode=menu] .card:hover {
      translate: 0 -10px
    }

    [data-mode=menu] .page * {
      pointer-events: none
    }

    .page {
      position: absolute;
      left: 0;
      top: 0;
      width: var(--W);
      height: var(--H);
      overflow: hidden
    }

    [data-mode=page] .card.on .page {
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: none
    }

    .in {
      position: relative;
      width: var(--W);
      height: var(--H);
      --m: calc(var(--W)*.012)
    }

    .in.tall {
      height: calc(var(--H)*1.32)
    }

    /* header */
    .hd {
      position: absolute;
      inset: 0 0 auto 0;

    /* ================= v3 ================= */
    /* clip the wide page row so phones do not zoom out to fit it */
    body {
      position: fixed;
      inset: 0;
      width: 100%;
      overflow: hidden;
      overscroll-behavior: none
    }

    @keyframes grain {
      0% {
        background-position: 0 0
      }

      20% {
        background-position: -30px 18px
      }

      40% {
        background-position: 22px -40px
      }

      60% {
        background-position: -12px 36px
      }

      80% {
        background-position: 40px 8px
      }

      100% {
        background-position: 0 0
      }
    }

    @keyframes fadein {
      from {
        opacity: 0
      }

      to {
        opacity: 1
      }
    }

    @keyframes wipe {
      from {
        clip-path: inset(0 100% 0 0)
      }

      to {
        clip-path: inset(0 0 0 0)
      }
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(40px)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    @keyframes chup {
      from {
        transform: translateY(110%)
      }

      to {
        transform: none
      }
    }

    .ph.has {
      animation: fadein .6s ease
    }

    #cases-strip .ph.has,
    #arch-strip .ph.has {
      animation: wipe 1s var(--ease)
    }

    .card {
      contain: layout style
    }

    .bn {
      display: inline-block
    }

    .ttb {
      background: none;
      border: 0;
      color: inherit;
      font: inherit;
      text-transform: inherit;
      padding: 0;
      cursor: pointer;
      text-align: left
    }

    .ttb .x {
      margin-left: .5em;
      transition: opacity .3s
    }

    .phase {
      margin-left: .6em
    }

    .dial i {
      transition: none
    }

    /* menu: title letters + card tilt */
    .ch {
      display: inline-block;
      overflow: hidden;
      vertical-align: top;
      padding-bottom: .14em;
      margin-bottom: -.14em
    }

    .ch>i {
      display: inline-block;
      font-style: normal
    }

    [data-mode=menu] .ch>i {
      animation: chup .8s var(--ease) both;
      animation-delay: calc(var(--i)*40ms + .3s)
    }

    /* intro */
    #intro {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: var(--paper);
      display: none;
      align-items: center;
      justify-content: center;
      clip-path: inset(0 0 0 0);
      transition: clip-path .9s var(--ease);
      pointer-events: none
    }

    .pre #intro {
      display: flex
    }

    #intro svg {
      width: min(34vw, 210px);
      height: auto;
      color: var(--ink);
      overflow: visible
    }

    /* logo: rings ripple outward from the centre */
    .lgs g,
    .lgi g {
      transform-origin: 29.5px 32px
    }

    .lgs path {
      transform-origin: 29.5px 32px
    }

    .lgs g[style] {
      animation: none
    }

    .go .card.on .lgs g[style] {
      animation: lgin .9s calc(var(--i)*.045s) var(--ease) backwards
    }

    .go .card.on .lgs path {
      animation: lgbr 12s calc(5s + var(--i)*70ms) ease-in-out infinite
    }

    .go .card.on .lg:hover .lgs path,
    .go .card.on .lg:focus-visible .lgs path {
      animation: lgp .9s calc(var(--i)*40ms) var(--ease)
    }

    @keyframes lgbr {

      0%,
      84%,
      100% {
        transform: none;
        opacity: 1
      }

      92% {
        transform: scale(1.045);
        opacity: .62
      }
    }

    @keyframes lgin {
      from {
        opacity: 0;
        transform: scale(.8) rotate(-10deg)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    @keyframes lgp {

      0%,
      100% {
        transform: none;
        opacity: 1
      }

      40% {
        transform: scale(1.08);
        opacity: .55
      }
    }

    .lgi g[style] {
      opacity: 0;
      animation: lgin 1s calc(.1s + var(--i)*.07s) cubic-bezier(.2, .7, .2, 1) forwards
    }

    .lgw {
      animation: lgsweep 1.7s .1s cubic-bezier(.45, 0, .2, 1) forwards
    }

    @keyframes lgsweep {
      to {
        stroke-dashoffset: 0
      }
    }

    #intro.out {
      clip-path: inset(0 0 100% 0)
    }

    .pre #cases-strip figure {
      opacity: 0
    }

    .go #cases-strip figure {
      animation: rise .9s var(--ease) backwards;
      animation-delay: calc(var(--k, 0)*70ms)
    }

    /* cursor + magnetic */
